<%= image_tag @product.photo, width: 200 if @product.photo.attached? %>
<h1 class="title"> <%= @product.title %> </h1>

<p class="description"> <%= @product.description %> </p>
<p class="price"> <%= @product.price %>$</p>

<%= link_to t('.edit'), edit_product_path(@product) if @product.owner? %> 
<%= button_to t('.delete'), product_path(@product), method: :delete, data: 
{ turbo_confirm: t('common.confirm') } if @product.owner? %>

<%= link_to t('.view_more_products', username: @product.user.username), user_path(@product.user.username) %>

<% if @product.favorites.find_by(user: Current.user) %>
  <%= button_to '💔', favorite_path(@product.id), method: :delete, data: {} %>
<% else %>
  <%= button_to '♥️', favorites_path(product_id: @product.id), method: :post, data: {} %>
<% end %>
