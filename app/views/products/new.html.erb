<h2>Añadir un nuevo producto</h2>

<%= form_with model: @product do |form| %>
  <%= @product.errors.full_messages.each do |error| %>
    <div>
      <%= error %>
    </div>
  <% end %>
  
  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>
  
  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description %>
  </div>
  
  <div>
    <%= form.label :price %><br>
    <%= form.number_field :price %>
  </div>

  <div>
    <%= form.submit %>
  </div>

<% end %>